# Cấu hình Hệ thống AI Procurement Agent & Quản lý Tồn kho (File mẫu cho các thành viên nhóm)
# Hướng dẫn: Sao chép file này thành backend/.env và thay thông tin PostgreSQL của máy bạn
PROJECT_NAME="Coffee AI Procurement Agent"
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# ==============================================================================
# CẤU HÌNH KẾT NỐI CƠ SỞ DỮ LIỆU POSTGRESQL
# ==============================================================================
# Cách 1: Kết nối PostgreSQL chạy bằng Docker (theo docker-compose.yml):
DATABASE_URL=postgresql://coffee_admin:coffee_secret_password@localhost:5432/coffee_inventory

# Cách 2: Nếu cài PostgreSQL / pgAdmin 4 trực tiếp trên Windows:
# DATABASE_URL=postgresql://postgres:MAT_KHAU_CUA_BAN@localhost:5432/AI AGENT

SECRET_KEY="coffee_super_secret_jwt_key_hutech_dacn_2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Đăng nhập & phân quyền: true = bật (mặc định), false = tắt (ai cũng vào được)
AUTH_ENABLED=true

# ==============================================================================
# CẤU HÌNH GOOGLE GEMINI AI AGENT (HYBRID MULTI-MODEL AI - TUẦN 7)
# ==============================================================================
# Lấy API Key từ Google AI Studio (https://aistudio.google.com/apikey) bằng tài khoản Google của bạn.
# Nếu để trống, hệ thống tự động dùng Hybrid Multi-Model Local Orchestrator (Ensemble ML + ROP + MCDM).
GEMINI_API_KEY=
GEMINI_AGENT_MODEL=gemini-3.8-flash
GEMINI_REASONING_MODEL=gemini-4-argon
