# Cấu hình Hệ thống AI Procurement Agent & Quản lý Tồn kho (File mẫu cho các thành viên nhóm)
# Hướng dẫn: Sao chép file này thành backend/.env và thay thông tin PostgreSQL của máy bạn
PROJECT_NAME="Coffee AI Procurement Agent"
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# ==============================================================================
# CẤU HÌNH KẾT NỐI CƠ SỞ DỮ LIỆU POSTGRESQL
